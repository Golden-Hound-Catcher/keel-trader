# DISABLED BY DEFAULT (Stage 7 quarantine) — do not enable for new installs.
# Preferred API: deploy/keel-api.service (uvicorn keel.api.app:app)
#
# This unit remains for legacy admin + read-only dashboard UI only.
# To intentionally re-enable:
#   sudo touch /opt/r20-quantum-trader/data/.enable_legacy_r20_quantum
#   sudo systemctl enable --now r20-quantum.service
# Conflicts with keel-api on the same port — do not run both.

[Unit]
Description=DISABLED-by-default LEGACY R20 control-plane backend (deprecated)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/r20-quantum-trader/data/.enable_legacy_r20_quantum
# Prefer deploy/keel-api.service; this unit is legacy admin + dashboard UI only.

[Service]
Type=simple
User=r20
Group=r20
Environment=HOME=/home/r20
Environment=PATH=/opt/r20-quantum-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/r20-quantum-trader
EnvironmentFile=/opt/r20-quantum-trader/.env
ExecStart=/usr/bin/env python3 -m uvicorn r20_backend.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
