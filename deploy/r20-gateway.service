[Unit]
Description=Keel Trader notification delivery worker (no job scheduler)
After=network.target
# Job scheduling is owned exclusively by keel-worker.service

[Service]
Type=simple
User=r20
Group=r20
Environment=HOME=/home/r20
Environment=PATH=/opt/r20-quantum-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Explicit: gateway must not schedule trader jobs
Environment=KEEL_DISABLE_GATEWAY_SCHEDULER=1
WorkingDirectory=/opt/r20-quantum-trader
EnvironmentFile=/opt/r20-quantum-trader/.env
ExecStart=/usr/bin/python3 -m r20_gateway.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
