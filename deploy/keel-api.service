[Unit]
Description=Keel Trader Primary Read-Only API (keel.api.app)
After=network-online.target
Wants=network-online.target
# Prefer this over legacy r20-quantum.service
Conflicts=r20-quantum.service

[Service]
Type=simple
User=r20
Group=r20
Environment=HOME=/home/r20
Environment=PATH=/opt/r20-quantum-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/r20-quantum-trader
EnvironmentFile=/opt/r20-quantum-trader/.env
ExecStart=/usr/bin/env python3 -m uvicorn keel.api.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
