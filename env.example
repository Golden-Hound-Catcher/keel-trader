# ==============================================================================
# KEEL TRADER - ENVIRONMENT CONFIGURATION TEMPLATE (Stage 4)
# Copy this file to .env and fill in your own credentials.
# Primary runtime: keel.api.app + keel.worker (r20_* paths are legacy).
# Prefer KEEL_* names below; R20_* / OKX_* aliases remain for migration.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM (OpenAI-compatible). Required only when using live LLM decisions.
# Paper/demo cycle (python -m keel.worker --once) does NOT need an LLM key.
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_REASONING_EFFORT=high

# ------------------------------------------------------------------------------
# OKX demo (safe default) + optional live. Create DEMO and LIVE keys separately.
# Keel paper cycle uses PaperAdapter and needs NO keys. Demo REST uses the
# OKX_*_DEMO_* group (or KEEL_OKX_*). Live trading requires R20_OKX_ENV=live
# (or KEEL_OKX_ENV=live) plus OKX_LIVE_* credentials.
# Do not commit real secrets; do not copy ~/.okx between users.
# ------------------------------------------------------------------------------
KEEL_OKX_ENV=demo
R20_OKX_ENV=demo
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
# Optional aliases (picked up by keel.config.settings):
# KEEL_OKX_API_KEY=  KEEL_OKX_SECRET_KEY=  KEEL_OKX_PASSPHRASE=
# Legacy single-key migration (optional):
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_SIMULATED=1

# ------------------------------------------------------------------------------
# Keel API / worker / risk
# ------------------------------------------------------------------------------
KEEL_API_HOST=0.0.0.0
KEEL_API_PORT=8080
# Optional override for SQLite ledger path (default: data/keel_ledger.db)
# KEEL_LEDGER_DB=
KEEL_MAX_POSITIONS=6
KEEL_MAX_DAILY_LOSS=150
KEEL_MAX_ASSET_MARGIN=600
# KEEL_USE_LEGACY=1 forces scripts/ai_factor_trader.py into the historical OKX-CLI loop
# KEEL_BRAIN_SHIM=1 routes scripts/ai_brain_trader.py into keel.worker.cycle

# ------------------------------------------------------------------------------
# Legacy dashboard / admin / notifications (optional; not required for Keel core)
# ------------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
R20_SETUP_TOKEN=replace_with_a_long_random_setup_token
R20_ADMIN_TOKEN=
R20_MANUAL_CLOSE_ENABLED=0
R20_NOTIFY_WEBHOOK_ENABLED=0
R20_NOTIFICATION_WEBHOOK=
R20_NOTIFY_WECHAT_ENABLED=0
R20_WECHAT_WEBHOOK=
R20_NOTIFY_TELEGRAM_ENABLED=0
R20_TELEGRAM_BOT_TOKEN=
R20_TELEGRAM_CHAT_ID=
R20_NOTIFY_QQ_ENABLED=0
R20_QQ_APP_ID=
R20_QQ_CLIENT_SECRET=
R20_QQ_OPENID=
R20_BACKUP_ENCRYPTION_KEY=
