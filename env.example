# ==============================================================================
# KEEL TRADER - ENVIRONMENT CONFIGURATION TEMPLATE (Stage 7)
# Copy to .env and fill credentials. Prefer KEEL_* names below.
# Primary runtime: keel.api.app + keel.worker (r20_* paths are legacy).
# Do not add new secret stores; env vars only. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Minimal env (paper cycle needs NONE of these)
#   python -m keel.worker --once   → PaperExchange when OKX keys absent
# ------------------------------------------------------------------------------
# KEEL_OKX_ENV=demo
# KEEL_OKX_API_KEY=
# KEEL_OKX_SECRET_KEY=
# KEEL_OKX_PASSPHRASE=
# KEEL_LLM_API_KEY=          # or LLM_API_KEY — only for live LLM decisions
# KEEL_API_PORT=8080

# ------------------------------------------------------------------------------
# LLM (OpenAI-compatible). Optional for rule-based paper/demo cycle.
# ------------------------------------------------------------------------------
KEEL_LLM_BASE_URL=
LLM_BASE_URL=https://api.openai.com/v1
KEEL_LLM_API_KEY=
LLM_API_KEY=
KEEL_LLM_MODEL=
LLM_MODEL=gpt-4o
KEEL_LLM_REASONING_EFFORT=
LLM_REASONING_EFFORT=high
# Decision policy: rule (default, offline) | stub | llm
# KEEL_DECISION_POLICY=rule
# Optional filesystem override for prompt modules (*.v1.txt)
# KEEL_PROMPT_MODULES_DIR=

# ------------------------------------------------------------------------------
# OKX — single Keel settings path (keel.config.settings)
# Worker uses OkxRestAdapter when KEEL_OKX_* (or aliases) are all set;
# otherwise PaperExchange. Demo REST sets x-simulated-trading: 1.
# ------------------------------------------------------------------------------
KEEL_OKX_ENV=demo
KEEL_OKX_API_KEY=
KEEL_OKX_SECRET_KEY=
KEEL_OKX_PASSPHRASE=
# Env-specific aliases (still supported):
R20_OKX_ENV=demo
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
# Legacy single-key migration (optional):
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_SIMULATED=1

# ------------------------------------------------------------------------------
# Keel API / worker / risk
# ------------------------------------------------------------------------------
KEEL_API_HOST=0.0.0.0
KEEL_API_PORT=8080
# Optional shared API token for non-local binds. Empty → no auth (local/demo default).
# When set, /api/v1/* requires Authorization: Bearer <token> or X-API-Key: <token>.
# /health, /docs, /openapi.json stay open. Frontend: VITE_KEEL_API_TOKEN=<same>.
# KEEL_API_TOKEN=
# KEEL_LEDGER_DB=
KEEL_MAX_POSITIONS=6
KEEL_MAX_DAILY_LOSS=150
KEEL_MAX_ASSET_MARGIN=600
# Trader cycle interval in seconds (default 900 = 15min). Clamped to [60, 86400].
# Scheduler JobSpec("trader") uses this; timeout = max(840, interval - 60).
# /ready worker_stale threshold = max(2×interval, interval+300).
# KEEL_CYCLE_INTERVAL_SECONDS=900
# Default Keel scheduler runs trader only (SPEC-supported keel-api + keel-worker).
# Set to 1/true to also schedule legacy script jobs: factor_library, news,
# daily_briefing, nightly_backup (scripts/*.py). Exposed on /api/v1/config as
# scheduler_jobs + legacy_scheduler_jobs. Scripts themselves are not deleted.
# KEEL_ENABLE_LEGACY_SCHEDULER_JOBS=0
# Comma-separated OKX swap ids for the worker/config watchlist.
# Empty → DEFAULT_CRYPTO_INSTRUMENTS (BTC/ETH/SOL/DOGE/SUI/LINK).
# Strip / drop empties / dedupe (preserve order). Unknown ids → Instrument.from_okx_swap.
# KEEL_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP
# Emergency kill switch (0|1 / true|false). When on, risk gates deny all trading
# actions (BUY_LONG / SELL_SHORT / scale / close). WAIT still ok. Default off.
# KEEL_KILL_SWITCH=0
# Optional cycle notify webhook (empty → NullNotifier; simple POST JSON)
# KEEL_NOTIFY_WEBHOOK_URL=
# KEEL_USE_LEGACY=1 acknowledges remaining legacy paths (silences quarantine warnings).
# Trader entry is python -m keel.worker only (ai_factor_trader shim removed).
# KEEL_ALLOW_LEGACY_BACKEND=1 is required to run the legacy r20_backend ASGI app
# (soft-blocked otherwise; admin remnant after U2). Prefer keel.api + keel.worker + frontend monitor.
# See LEGACY.md. Do not enable r20-*.service by default.
# (KEEL_BRAIN_SHIM retired with scripts/ai_brain_trader.py — use python -m keel.worker)

# ------------------------------------------------------------------------------
# Legacy admin / notifications (optional; not required for Keel core).
# Jinja dashboard/ removed in U2 — DASHBOARD_* unused.
# ------------------------------------------------------------------------------
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080
R20_SETUP_TOKEN=replace_with_a_long_random_setup_token
R20_ADMIN_TOKEN=
R20_MANUAL_CLOSE_ENABLED=0
R20_NOTIFY_WEBHOOK_ENABLED=0
R20_NOTIFICATION_WEBHOOK=
R20_NOTIFY_WECHAT_ENABLED=0
R20_WECHAT_WEBHOOK=
R20_NOTIFY_TELEGRAM_ENABLED=0
R20_TELEGRAM_BOT_TOKEN=
R20_TELEGRAM_CHAT_ID=
R20_NOTIFY_QQ_ENABLED=0
R20_QQ_APP_ID=
R20_QQ_CLIENT_SECRET=
R20_QQ_OPENID=
R20_BACKUP_ENCRYPTION_KEY=
