# ==============================================================================
# KEEL TRADER - ENVIRONMENT CONFIGURATION TEMPLATE (Stage 7)
# Copy to .env and fill credentials. Prefer KEEL_* names below.
# Primary runtime: keel.api.app + keel.worker (r20_* paths are legacy).
# Do not add new secret stores; env vars only. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Minimal env (paper cycle needs NONE of these)
#   python -m keel.worker --once   → PaperExchange when OKX keys absent
# ------------------------------------------------------------------------------
# KEEL_OKX_ENV=demo
# KEEL_OKX_API_KEY=
# KEEL_OKX_SECRET_KEY=
# KEEL_OKX_PASSPHRASE=
# KEEL_LLM_API_KEY=          # or LLM_API_KEY — only for live LLM decisions
# KEEL_API_PORT=8080

# ------------------------------------------------------------------------------
# LLM (OpenAI-compatible). Optional for rule-based paper/demo cycle.
# ------------------------------------------------------------------------------
KEEL_LLM_BASE_URL=
LLM_BASE_URL=https://api.openai.com/v1
KEEL_LLM_API_KEY=
LLM_API_KEY=
KEEL_LLM_MODEL=
LLM_MODEL=gpt-4o
KEEL_LLM_REASONING_EFFORT=
LLM_REASONING_EFFORT=high
# Decision policy: rule (default, offline) | stub | llm
# KEEL_DECISION_POLICY=rule
# Rule policy v2 optional thresholds (defaults match prior RSI bands):
# KEEL_RULE_RSI_LONG_MAX=42
# KEEL_RULE_RSI_SHORT_MIN=58
# KEEL_RULE_MIN_VOLUME_RATIO=1.0
# Optional filesystem override for prompt modules (*.v1.txt)
# KEEL_PROMPT_MODULES_DIR=

# ------------------------------------------------------------------------------
# OKX — single Keel settings path (keel.config.settings)
# Worker uses OkxRestAdapter when KEEL_OKX_* (or aliases) are all set;
# otherwise PaperExchange. Demo REST sets x-simulated-trading: 1.
# Demo trial: copy this file to .env (never commit). See RUNBOOK.md §3.
# Paper dry-run needs no keys; ./scripts/run_acceptance.sh forces empty keys.
# Never paste API keys into chat — keep them in local .env only.
# ------------------------------------------------------------------------------
KEEL_OKX_ENV=demo
KEEL_OKX_API_KEY=
KEEL_OKX_SECRET_KEY=
KEEL_OKX_PASSPHRASE=
# Env-specific aliases (still supported):
R20_OKX_ENV=demo
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
# Legacy single-key migration (optional):
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_SIMULATED=1

# ------------------------------------------------------------------------------
# Keel API / worker / risk
# ------------------------------------------------------------------------------
KEEL_API_HOST=0.0.0.0
KEEL_API_PORT=8080
# Optional shared API token for non-local binds. Empty → no auth (local/demo default).
# When set, /api/v1/* requires Authorization: Bearer <token> or X-API-Key: <token>.
# /health, /docs, /openapi.json stay open. Frontend: VITE_KEEL_API_TOKEN=<same>.
# KEEL_API_TOKEN=
# KEEL_LEDGER_DB=
KEEL_MAX_POSITIONS=6
KEEL_MAX_DAILY_LOSS=150
KEEL_MAX_ASSET_MARGIN=600
# Max notional (USDT) per instrument = existing + requested (margin×leverage).
# Default 2000 ≈ max asset margin 600 × ~3.3 leverage. Exposed on /api/v1/config.
# KEEL_MAX_NOTIONAL_PER_INSTRUMENT=2000
# Max contracts (size units) per instrument when size is known at gate time.
# KEEL_MAX_CONTRACTS_PER_INSTRUMENT=50
# First-live tighter caps (used when KEEL_OKX_ENV=live AND KEEL_SHADOW_MODE=0).
# Paper / demo / shadow keep KEEL_MAX_* above. Exposed on /config as live_* + effective_*.
# KEEL_LIVE_MAX_NOTIONAL_PER_INSTRUMENT=200
# KEEL_LIVE_MAX_CONTRACTS_PER_INSTRUMENT=5
# Trader cycle interval in seconds (default 900 = 15min). Clamped to [60, 86400].
# Scheduler JobSpec("trader") uses this; timeout = max(840, interval - 60).
# /ready worker_stale threshold = max(2×interval, interval+300).
# Explicit seconds always win over KEEL_OBSERVE_PRESET when set.
# KEEL_CYCLE_INTERVAL_SECONDS=900
# Q0 observation cadence preset when seconds unset: default=900 | fast=300 | slow=1800.
# Exposed as observe_preset on /api/v1/config (null when unset).
# KEEL_OBSERVE_PRESET=default
# KEEL_OBSERVE_FORCE=0   # 1 = observe_up may stop only our pidfile PIDs (never foreign)
# Keel scheduler runs trader only (SPEC-supported keel-api + keel-worker).
# /api/v1/config exposes scheduler_jobs=["trader"]. Legacy script jobs removed.
# Comma-separated OKX swap ids for the worker/config watchlist.
# Empty → DEFAULT_CRYPTO_INSTRUMENTS (BTC/ETH/SOL/DOGE/SUI/LINK).
# Strip / drop empties / dedupe (preserve order). Unknown ids → Instrument.from_okx_swap.
# KEEL_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP
# Emergency kill switch (0|1 / true|false). When on, blocks *real* exchange
# place_order. WAIT still ok. With KEEL_SHADOW_MODE=1, shadow_fill still records.
# Default off.
# KEEL_KILL_SWITCH=0
# Shadow execution (0|1). When on, decisions that pass risk ledger a shadow_fill
# (+ synthetic trade marked shadow) instead of calling exchange place_order.
# Kill-switch = no real orders; shadow rehearsal still allowed. Default off.
# KEEL_SHADOW_MODE=0
# Arming checklist: warn (or block when REQUIRE=1) if no shadow_fill in last N hours.
# KEEL_ARMING_SHADOW_HOURS=24
# KEEL_ARMING_REQUIRE_SHADOW=0
# Q3 near-signal shadow probe (0|1, default off). When kill+shadow+probe are all
# on, strong WAIT near-signals (signal_diag.nearest in {long,short}, missing<=N)
# may become shadow_fill rehearsal fills — NEVER live exchange orders.
# KEEL_SHADOW_NEAR_PROBE=0
# KEEL_SHADOW_NEAR_PROBE_COOLDOWN_SECONDS=900
# KEEL_SHADOW_NEAR_PROBE_MAX_MISSING=2
# KEEL_SHADOW_NEAR_PROBE_MIN_CONFIDENCE=0
# Q3.4: fee-aware min edge hurdle before near-probe shadow_fill (unset → RT/open fee bps).
# KEEL_SHADOW_NEAR_PROBE_MIN_EDGE_BPS=
# KEEL_SHADOW_NEAR_PROBE_EDGE_MODE=round_trip
# Q3.3 fee-aware shadow markout (OKX USDT-SWAP). Role default taker (immediate fill).
# Live rates: GET /api/v5/account/trade-fee?instType=SWAP → makerU/takerU (not maker/taker).
# Fallback = OKX Regular USDT-margined: maker 2.0 bps / taker 5.0 bps.
# KEEL_SHADOW_FEE_ROLE=taker
# Optional bps overrides (positive=cost, negative=rebate); sets source=override.
# KEEL_SHADOW_MAKER_FEE_BPS=
# KEEL_SHADOW_TAKER_FEE_BPS=
# Optional cycle notify webhook (empty → NullNotifier; no network)
# KEEL_NOTIFY_WEBHOOK_URL=
# When 1/true: skip POST unless cycle alert (not ok / risk_denies>0 / error_count>0)
# KEEL_NOTIFY_ALERTS_ONLY=0
# Webhook JSON shape: keel={"event","payload"} (default) | discord={"content": text≤1900}
# KEEL_NOTIFY_FORMAT=keel
# Trader entry is python -m keel.worker only (legacy r20_* packages removed).
# Prefer keel.api + keel.worker + optional frontend monitor. See LEGACY.md.
# (KEEL_BRAIN_SHIM retired with scripts/ai_brain_trader.py — use python -m keel.worker)

# ------------------------------------------------------------------------------
# Legacy admin / notifications (optional; not required for Keel core).
# Jinja dashboard/ removed in U2 — DASHBOARD_* unused.
# ------------------------------------------------------------------------------
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080
R20_SETUP_TOKEN=replace_with_a_long_random_setup_token
R20_ADMIN_TOKEN=
R20_MANUAL_CLOSE_ENABLED=0
R20_NOTIFY_WEBHOOK_ENABLED=0
R20_NOTIFICATION_WEBHOOK=
R20_NOTIFY_WECHAT_ENABLED=0
R20_WECHAT_WEBHOOK=
R20_NOTIFY_TELEGRAM_ENABLED=0
R20_TELEGRAM_BOT_TOKEN=
R20_TELEGRAM_CHAT_ID=
R20_NOTIFY_QQ_ENABLED=0
R20_QQ_APP_ID=
R20_QQ_CLIENT_SECRET=
R20_QQ_OPENID=
R20_BACKUP_ENCRYPTION_KEY=
